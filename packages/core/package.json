{
  "name": "@loadstate/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@loadstate/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "fixtures:generate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-fixtures.ts",
    "openapi:generate": "pnpm run build && node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@hyperjump/json-schema": "1.18.0"
  }
}
